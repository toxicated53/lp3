pragma solidity ^0.8.20;

contract StudentData {

    // 1. Structure to store student details
    struct Student {
        uint rollNo;
        string name;
        uint age;
        string course;
    }

    // 2. Array to store student records
    Student[] public students;

    // Events
    event StudentAdded(uint rollNo, string name);
    event FallbackCalled(address sender, uint amount);
    event Received(address sender, uint amount);

    // 3. Function to add student
    function addStudent(
        uint _rollNo,
        string memory _name,
        uint _age,
        string memory _course
    ) public {
        students.push(
            Student(_rollNo, _name, _age, _course)
        );

        emit StudentAdded(_rollNo, _name);
    }

    // Function to retrieve student details
    function getStudent(uint index)
        public
        view
        returns (uint, string memory, uint, string memory)
    {
        require(index < students.length, "Invalid student index");

        Student memory s = students[index];

        return (s.rollNo, s.name, s.age, s.course);
    }

    // Function to get total students
    function getStudentCount() public view returns (uint) {
        return students.length;
    }

    // Receive function to accept plain Ether transfers
    receive() external payable {
        emit Received(msg.sender, msg.value);
    }

    // Fallback function for unmatched function calls
    fallback() external payable {
        emit FallbackCalled(msg.sender, msg.value);
    }
}

